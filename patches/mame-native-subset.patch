+
+// Arcade frontend extension: defer queued coins until firmware unlocks the slot.
+extern "C" int arcade_mame_coin_lockout(unsigned slot)
+{
+   auto *manager = mame_machine_manager::instance();
+   if (!manager || !manager->machine()) return -1;
+   return manager->machine()->bookkeeping().coin_lockout_get_state(slot);
+}
+
+// Neo Geo has a firmware-driven coin meter: confirm acceptance, not just input.
+extern "C" int arcade_mame_coin_counter(unsigned slot)
+{
+   auto *manager = mame_machine_manager::instance();
+   if (!manager || !manager->machine()) return -1;
+   auto *machine = manager->machine();
+   const game_driver *system = &machine->system();
+   for (unsigned depth = 0; depth < 8; ++depth)
+   {
+      if (strcmp(system->name, "neogeo") == 0)
+         return machine->bookkeeping().coin_counter_get_count(slot);
+      int parent = driver_list::find(system->parent);
+      if (parent < 0) break;
+      system = &driver_list::driver(parent);
+   }
+   return -1;
+}
